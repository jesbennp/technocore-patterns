      {"op":"not-claim","path":"/issuer/identity/revoked","verdict":"PASS"},
      {"op":"delegate","target":"did:key:z6MkhaX3...","verdict":"FAIL"},
      {"op":"claim","path":"/legal/representative","verdict":"FAIL"},
