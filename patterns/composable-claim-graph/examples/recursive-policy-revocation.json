          "policy": {
            "op": "or",
            "args": [
              { "op": "claim", "path": "/legal/representative" },
              {
                "op": "and",
                "args": [
                  { "op": "claim", "path": "/legal/agent/authorized" },
                  { "op": "not-claim", "path": "/legal/agent/revoked" },
                  {
                    "op": "delegate",
                    "target": "did:key:z6MkjNoxcQj8sK9p4e2VtR7yW5bX1n3LmNopPqR4tL8gH8w7N",
                    "policy": {
                      "op": "claim",
                      "path": "/capability/sign-contracts",
